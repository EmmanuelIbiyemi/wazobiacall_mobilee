{
  "expo": {
    "name": "Wazobia Call",
    "slug": "calltranscribe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mobileicon/wazobiaicon.png",
    "scheme": "calltranscribe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/mobileicon/wazobiaicon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Wazobia Call uses the microphone so you can talk during calls.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C4DD6",
        "foregroundImage": "./assets/images/mobileicon/wazobiaicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abefe.calltranscribe",
      "permissions": [
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C4DD6",
          "image": "./assets/images/mobileicon/wazobiaicon.png",
          "imageWidth": 130
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/custom_sound.wav"
          ]
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "expo-asset",
      "@config-plugins/react-native-webrtc",
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "da10e9cd-a980-4a8b-b28b-eb12cd22080f"
      }
    }
  }
}
